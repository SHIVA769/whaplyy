# Environment: development, production
NODE_ENV=development

# Server
PORT=5000

# ========== DATABASE CONFIGURATION ==========
# Supabase PostgreSQL Connection Strings
# Get these from your Supabase Project Settings → Database

# Main connection string (use for migrations)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@db.supabasehost.com:5432/postgres

# Direct connection string (bypass pooler for migrations, if needed)
# Use this if DATABASE_URL uses connection pooling
DIRECT_URL=postgresql://user:password@db.supabasehost.com:6543/postgres

# ========== SUPABASE ==========
# From Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========== AUTHENTICATION ==========
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
JWT_EXPIRE=7d

# ========== EMAIL CONFIGURATION ==========
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=WhatsStore
SMTP_FROM_EMAIL=noreply@whatsstore.io

# Or use Resend (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here

# ========== FILE UPLOAD ==========
# Local storage or cloud storage
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# AWS S3 Configuration (optional)
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=your_access_key
AWS_S3_SECRET_ACCESS_KEY=your_secret_key

# ========== PAYMENT GATEWAYS ==========
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_SECRET=your_secret

RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_secret

# ========== NOTIFICATIONS & MESSAGING ==========
# Twilio SMS
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ========== FRONTEND URL ==========
FRONTEND_URL=http://localhost:5173

# ========== SECURITY ==========
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========== LOGGING ==========
LOG_LEVEL=debug
LOG_FORMAT=json
